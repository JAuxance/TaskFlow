APP_ENV=development
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=taskflow
DATABASE_USER=taskflow_app
DATABASE_PASSWORD=change_me_app_password
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
DATABASE_APP_PASSWORD=change_me_app_password
SECRET_KEY=change_me
DOMAIN=taskflow.example.com
PUBLIC_ORIGIN=https://taskflow.example.com
# Set to 1 only after installing the documented trusted Nginx configuration.
TRUST_PROXY_HEADERS=0
# Public contact for data requests. This mailbox is already in use.
PRIVACY_CONTACT_EMAIL=contact@auxance.dev
# Account deletions recorded outside the database. Production compose sets this.
DELETION_LOG_PATH=/var/taskflow/deletions.log
